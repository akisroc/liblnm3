{% block body %}
<section>
    {% for post in posts %}
        <article>
            <p>{{ post.topic_title }}</p>
            <p>{{ post.post_content }}</p>
            <p>{{ post.author }}</p>
            <p>{{ post.place }}</p>
        </article>
        <hr/>
    {% endfor %}
</section>
{% endblock %}
